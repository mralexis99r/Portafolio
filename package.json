  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-seo.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch api/index.ts",
    "build": "tsc -b && node scripts/generate-seo.mjs && vite build",
