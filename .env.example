# Public site URL used for CORS and canonical deployment documentation.
SITE_URL=http://localhost:5173
PORT=3001

# Use a long, unique secret in production (32+ characters).
SESSION_SECRET=replace-with-a-long-random-session-secret
ANALYTICS_HASH_SECRET=replace-with-a-different-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Local development defaults to file:./data/analytics.db when omitted.
TURSO_DATABASE_URL=file:./data/analytics.db
TURSO_AUTH_TOKEN=

# Privacy controls.
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
